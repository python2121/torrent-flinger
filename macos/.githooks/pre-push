#!/usr/bin/env bash
# pre-push gate: the macOS test suite must pass before any push reaches the
# remote. Also runs the Linux app's Python tests when a venv is present, so a
# shared-repo push can't break the other target.
#
# Activate with: git config core.hooksPath macos/.githooks
# Bypass in a genuine emergency with `git push --no-verify`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/macos"

echo "==> pre-push: running the macOS self-test suite before push..."
if ! ./test.sh; then
  echo >&2
  echo "✗ pre-push blocked: swift test failed. Fix the tests, then push again." >&2
  echo "  (To bypass in an emergency: git push --no-verify)" >&2
  exit 1
fi

cd "$ROOT/linux"
if [[ -x .venv/bin/python ]]; then
  echo "==> pre-push: running the Linux app's Python tests..."
  if ! PYTHONPATH=. .venv/bin/python -m unittest discover tests -q; then
    echo "✗ pre-push blocked: Python tests failed." >&2
    exit 1
  fi
fi

echo "==> pre-push: tests passed — allowing push."
